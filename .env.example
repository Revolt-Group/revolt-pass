# =====================================================================
# Revolt Pass Environment Configuration (.env.example)
# Copy this file to .env.local to customize your instance
# =====================================================================

# Set to 'true' to restrict public access and lock registration on private instances.
# When true, unfamiliar devices see a restricted notice and require Ctrl+Shift+U to log in.
# Default for open-source self-hosting: false
VITE_PRIVATE_INSTANCE=false
