name = "revolt-pass"
main = "src/worker/index.ts"
compatibility_date = "2024-09-01"
compatibility_flags = ["nodejs_compat"]

# Activar workers.dev o configurar dominio propio personalizado:
workers_dev = true
# routes = [
#   { pattern = "tu-dominio.com", custom_domain = true }
# ]

# Servir frontend estático compilado por Vite
[assets]
directory = "./dist"
binding = "ASSETS"

# Base de datos Cloudflare D1
# Crea tu base de datos ejecutando: pnpm wrangler d1 create revolt-pass-db
# Luego pega el database_id obtenido aquí:
[[d1_databases]]
binding = "DB"
database_name = "revolt-pass-db"
database_id = "<TU_DATABASE_ID_AQUI>"

# Variables de entorno públicas
[vars]
ENVIRONMENT = "production"
APP_NAME = "Revolt Pass"
APP_DOMAIN = "https://tu-dominio.com"
